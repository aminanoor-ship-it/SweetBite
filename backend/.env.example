NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=sweetbite_user
DB_PASSWORD=your_database_password
DB_NAME=sweetbite_db
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501
PUBLIC_BASE_URL=http://localhost:5000
MAX_UPLOAD_MB=2
ADMIN_NAME=SweetBite Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sweetbite.com
ADMIN_PASSWORD=replace_with_a_secure_password
